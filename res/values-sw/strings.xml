    <string name="help_custom_action3">Tendo ulilounda linaweza kuwekwa kwenye kitufe kupitia mipangilio <xliff:g id="ref_preference_title_customize_keypad">"Badilisha kibodi padio"</xliff:g>.</string>
    <string name="help_custom_constant1">Kwa kuunda konstanti ya mtumiaji, unaweza kufafanua konstanti kama vile <xliff:g id="pi">"π"</xliff:g> na kuitumia katika hesabu zako.</string>
    <string name="help_custom_constant2">Kwa mfano, ikiwa utaweka jina la thamani kuwa <xliff:g id="napier_name">"e"</xliff:g> na thamani kuwa <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, unaweza kurejelea nambari ya Napier kutoka kwenye maandiko yako ukitumia <xliff:g id="napier_name">"e"</xliff:g>.</string>
    <string name="help_custom_constant_name">Jina la konstanti hutofautisha herufi kubwa na ndogo.</string>
