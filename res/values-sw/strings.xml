    <string name="help_custom_action2">Kwa mfano, ukiweka jina la tendo kama "Tax" na thamani kama <xliff:g id="expression">[+ 6%]</xliff:g>, itaonyesha bei yenye kodi.</string>
    <string name="help_custom_action_name">Ingiza jina la tendo linaloonyeshwa kwenye kitufe.</string>
