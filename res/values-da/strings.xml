    <string name="help_tutorial_01">Skriv udtryk i redigeringsområdet, resultatet vises automatisk til højre. Udtryk kan redigeres når som helst, ligesom i en notesblok.</string>
    <string name="help_tutorial_02">Tryk på resultat for binær, hex, inkl. moms, ekskl. moms. Langt tryk for kopi.</string>
    <string name="help_tutorial_03">Du kan regne på flere linjer og skrive kommentarer.</string>
    <string name="help_tutorial_04">Hver linje beregnes, så du hurtigt kan sammenligne.</string>
    <string name="help_tutorial_05">En total vises, samt gennemsnit, moms inkluderet/ekskluderet.</string>
    <string name="help_tutorial_06">Tryk på linjenummer for at indsætte <xliff:g id="variable_name">"$2"</xliff:g> f.eks.</string>
    <string name="help_tutorial_07">Referér linjer i udtryk. Eks: $2 - $3.</string>
    <string name="help_tutorial_08">Ændres linje 2/3, opdateres alle referencer automatisk.</string>
    <string name="help_tutorial_09">Udfør sub-handling ved at swipe knappen op/ned.</string>
    <string name="help_tutorial_10">Du kan skifte tastatur ved at swipe til venstre eller højre. Du kan også fuldstændigt tilpasse en tastaturlayout på indstillingssiden <xliff:g id="ref_preference_title_customize_keypad">"Tilpas tastaturet"</xliff:g>.</string>
