    <string name="help_custom_function_argument_count">Изберете броя параметри.</string>
    <string name="help_custom_function_return_value_description">Въведете описание на възвръщаемата стойност. Използва се в помощта, незадължително.</string>
    <string name="help_custom_function_arg_name">Въведете име на параметъра.</string>
    <string name="help_custom_function_arg_description">Въведете описание на параметъра. Използва се в помощта, по избор.</string>
    <string name="help_custom_code">Напишете код в <xliff:g id="programming_language">JavaScript</xliff:g>.</string>
