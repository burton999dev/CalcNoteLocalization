    <string name="help_custom_keypad_edit_setting_primary_columns">Stabiliți granița dintre butoanele numerice și cele operator.</string>
    <string name="help_custom_result1">Puteți personaliza dialogul afișat la atingerea rezultatului calculelor.</string>
    <string name="help_custom_result2">Puteți referi rezultatul calculelor folosind variabila <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_result3">De exemplu, dacă setați titlul „10% OFF” și expresia <xliff:g id="expression">[result - 10%]</xliff:g>, se va afișa cu o reducere de 10% aplicată.</string>
    <string name="help_custom_result4">De asemenea, puteți folosi o funcție într-o expresie matematică. De exemplu, dacă setați titlul <xliff:g id="title">"EUR→USD"</xliff:g> și expresia <xliff:g id="expression">[eur_usd(result)]</xliff:g>, puteți afișa valoarea în dolari SUA convertită din euro.</string>
    <string name="help_custom_result_title">Introduceți titlul.</string>
    <string name="help_custom_result_expression">Introduceți expresia. Puteți referi rezultatul calculelor folosind variabila <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_action1">Creând o acțiune definită de utilizator, puteți atribui butonului expresii arbitrare.</string>
    <string name="help_custom_action2">De exemplu, dacă setați numele acțiunii „Tax” și valoarea <xliff:g id="expression">[+ 6%]</xliff:g>, se va afișa prețul cu taxă inclusă.</string>
    <string name="help_custom_action_name">Introduceți numele acțiunii afișat pe buton.</string>
    <string name="help_custom_action_value">O expresie arbitrară poate fi setată pentru valoare.</string>
    <string name="help_custom_action3">Acțiunea creată poate fi atribuită unui buton în ecranul de setări <xliff:g id="ref_preference_title_customize_keypad">"Personalizați tastatura"</xliff:g>.</string>
    <string name="help_custom_constant1">Creând o constantă definită de utilizator, puteți defini o constantă arbitrară precum <xliff:g id="pi">"π"</xliff:g> și o puteți folosi în expresiile dvs.</string>
    <string name="help_custom_constant2">De exemplu, dacă setați numele constantei <xliff:g id="napier_name">"e"</xliff:g> și valoarea <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, puteți face referire la numărul lui Napier din expresii folosind <xliff:g id="napier_name">"e"</xliff:g>.</string>
    <string name="help_custom_constant_name">Numele constantei este case-sensitive.</string>
