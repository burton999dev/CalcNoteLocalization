    <string name="help_custom_result1">Voit mukauttaa valintaikkunaa, joka näkyy napautettaessa laskentatulosta.</string>
    <string name="help_custom_result2">Voit viitata laskentatulokseen muuttujalla <xliff:g id="variable_name">"result"</xliff:g>.</string>
