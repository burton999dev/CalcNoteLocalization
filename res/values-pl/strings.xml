    <string name="help_custom_keypad_edit_setting_primary_columns">Ustaw granicę między przyciskami liczbowymi a operatorami.</string>
    <string name="help_custom_result1">Możesz dostosować okno dialogowe wyświetlane po stuknięciu wyniku obliczeń.</string>
    <string name="help_custom_result2">Możesz odwołać się do wyniku obliczeń, używając zmiennej o nazwie <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_result3">Na przykład, ustawiając tytuł jako "10% OFF" i wyrażenie <xliff:g id="expression">[result - 10%]</xliff:g>, można wyświetlić wynik z zastosowaniem 10% rabatu.</string>
    <string name="help_custom_result4">Możesz też użyć funkcji w wyrażeniu matematycznym. Na przykład, ustawiając tytuł jako <xliff:g id="title">"EUR→USD"</xliff:g> i wyrażenie <xliff:g id="expression">[eur_usd(result)]</xliff:g>, wyświetlisz wartość w USD przeliczoną z EUR.</string>
    <string name="help_custom_result_title">Wprowadź tytuł.</string>
    <string name="help_custom_result_expression">Wprowadź wyrażenie. Możesz odwołać się do wyniku obliczeń, używając zmiennej <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_action1">Tworząc akcję użytkownika, możesz przypisać dowolne wyrażenia do przycisku.</string>
    <string name="help_custom_action2">Na przykład, ustawiając nazwę akcji na "Tax" i wartość <xliff:g id="expression">[+ 6%]</xliff:g>, można wyświetlić cenę z podatkiem.</string>
    <string name="help_custom_action_name">Wprowadź nazwę akcji wyświetlaną na przycisku.</string>
    <string name="help_custom_action_value">Można ustawić dowolne wyrażenie dla wartości.</string>
    <string name="help_custom_action3">Utworzona akcja może zostać przypisana do przycisku na ekranie ustawień <xliff:g id="ref_preference_title_customize_keypad">"Dostosuj klawiaturę"</xliff:g>.</string>
    <string name="help_custom_constant1">Tworząc stałą użytkownika, możesz zdefiniować dowolną stałą, np. <xliff:g id="pi">"π"</xliff:g>, i używać jej w wyrażeniach.</string>
    <string name="help_custom_constant2">Na przykład, ustawiając nazwę stałej na <xliff:g id="napier_name">"e"</xliff:g> i wartość <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, możesz odwoływać się do liczby Napiera w wyrażeniach, używając <xliff:g id="napier_name">"e"</xliff:g>.</string>
    <string name="help_custom_constant_name">Nazwa stałej jest wrażliwa na wielkość liter.</string>
    <string name="help_custom_constant_value">Można ustawić dowolną liczbę dla wartości.</string>
    <string name="help_custom_constant3">Utworzona stała może zostać przypisana do przycisku na ekranie ustawień <xliff:g id="ref_preference_title_customize_keypad">"Dostosuj klawiaturę"</xliff:g>.</string>
    <string name="help_custom_function1">Tworząc funkcję użytkownika, możesz zdefiniować logikę obliczeń w języku <xliff:g id="programming_language">JavaScript</xliff:g>.</string>
    <string name="help_custom_function2">Utworzona funkcja może zostać przypisana do przycisku na ekranie ustawień <xliff:g id="ref_preference_title_customize_keypad">"Dostosuj klawiaturę"</xliff:g>.</string>
