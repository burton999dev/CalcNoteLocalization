    <string name="help_custom_constant1">Felhasználói állandó létrehozásával tetszőleges konstans definiálható, mint a <xliff:g id="pi">"π"</xliff:g>.</string>
    <string name="help_custom_constant2">Például, ha a konstans neve <xliff:g id="napier_name">"e"</xliff:g> és az értéke <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, a kifejezésekben <xliff:g id="napier_name">"e"</xliff:g>-ként hivatkozhat rá.</string>
