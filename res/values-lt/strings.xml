    <string name="help_custom_keypad_edit_setting_primary_columns">Nustatykite ribą tarp skaičių mygtukų ir operatorių mygtukų.</string>
    <string name="help_custom_result1">Galite tinkinti dialogą, rodomą bakstelėjus skaičiavimo rezultatą.</string>
    <string name="help_custom_result2">Skaičiavimo rezultatui galite nurodyti naudodami kintamąjį <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_result3">Pavyzdžiui, jei nustatysite pavadinimą "10% NUOLAIDA" ir reiškinį <xliff:g id="expression">[result - 10%]</xliff:g>, rezultatas bus rodomas su 10% nuolaida.</string>
    <string name="help_custom_result4">Taip pat galite naudoti funkciją matematiniam reiškiniui. Pavyzdžiui, jei nustatysite pavadinimą kaip <xliff:g id="title">"EUR→USD"</xliff:g> ir reiškinį kaip <xliff:g id="expression">[eur_usd(result)]</xliff:g>, galėsite parodyti konvertuotą JAV dolerių vertę iš eurų.</string>
    <string name="help_custom_result_title">Įveskite pavadinimą.</string>
    <string name="help_custom_result_expression">Įveskite reiškinį. Galite naudoti skaičiavimo rezultatą kaip kintamąjį, vadinamą <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_action1">Sukūrę vartotojo veiksmą, galite priskirti mygtukui norimus reiškinius.</string>
    <string name="help_custom_action2">Pavyzdžiui, jei veiksmo pavadinimas "Mokesčiai" ir reikšmė <xliff:g id="expression">[+ 6%]</xliff:g>, rezultatas bus rodomas su pridėtu 6% mokesčiu.</string>
    <string name="help_custom_action_name">Įveskite mygtuke rodomą veiksmo pavadinimą.</string>
    <string name="help_custom_action_value">Reikšmei galima nustatyti bet kokį matematinį reiškinį.</string>
    <string name="help_custom_action3">Sukurtą veiksmą galima priskirti mygtukui nustatymuose <xliff:g id="ref_preference_title_customize_keypad">"Tinkinti klaviatūrą"</xliff:g>.</string>
    <string name="help_custom_constant1">Sukurdami vartotojo apibrėžtą konstantą, galite apibrėžti savavališką konstantą, pvz., <xliff:g id="pi">"π"</xliff:g>, ir naudoti ją savo reiškiniuose.</string>
    <string name="help_custom_constant2">Pavyzdžiui, jei konstantos pavadinimas <xliff:g id="napier_name">"e"</xliff:g> ir reikšmė <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, galite naudoti Neperio skaičių reiškiniuose kaip <xliff:g id="napier_name">"e"</xliff:g>.</string>
