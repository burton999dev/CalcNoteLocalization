    <string name="help_custom_constant3">Η δημιουργημένη σταθερά μπορεί να ανατεθεί σε κουμπί από την οθόνη ρυθμίσεων <xliff:g id="ref_preference_title_customize_keypad">"Προσαρμογή πληκτρολογίου"</xliff:g>.</string>
    <string name="help_custom_function1">Με δημιουργία συνάρτησης οριζόμενης από το χρήστη, μπορείτε να ορίσετε λογική υπολογισμού σε <xliff:g id="programming_language">JavaScript</xliff:g>.</string>
    <string name="help_custom_function2">Η δημιουργημένη συνάρτηση μπορεί να ανατεθεί σε κουμπί από την οθόνη ρυθμίσεων <xliff:g id="ref_preference_title_customize_keypad">"Προσαρμογή πληκτρολογίου"</xliff:g>.</string>
    <string name="help_custom_function_name">Εισαγάγετε το όνομα της συνάρτησης.</string>
    <string name="help_custom_function_description">Εισαγάγετε περιγραφή της συνάρτησης. Χρησιμοποιείται ως βοήθεια. Προαιρετικό πεδίο.</string>
    <string name="help_custom_function_argument_count">Επιλέξτε τον αριθμό παραμέτρων.</string>
    <string name="help_custom_function_return_value_description">Εισαγάγετε περιγραφή της τιμής επιστροφής. Χρησιμοποιείται ως βοήθεια. Προαιρετικό.</string>
    <string name="help_custom_function_arg_name">Εισαγάγετε το όνομα παραμέτρου.</string>
    <string name="help_custom_function_arg_description">Εισαγάγετε περιγραφή παραμέτρου. Χρησιμοποιείται ως βοήθεια. Προαιρετικό.</string>
    <string name="help_custom_code">Γράψτε κώδικα σε <xliff:g id="programming_language">JavaScript</xliff:g>.</string>
    <string name="help_custom_function_arg_value">Εισαγάγετε τιμή ορίσματος για δοκιμή.</string>
    <string name="help_custom_function_test">Εκτελέστε τη συνάρτηση με το καθορισμένο όρισμα. Επαληθεύστε ότι το αποτέλεσμα είναι σωστό.</string>
    <string name="help_custom_template_list_creating">Αποθηκεύοντας μια συχνά χρησιμοποιούμενη έκφραση ως πρότυπο, μπορείτε εύκολα να δημιουργήσετε αρχείο βασισμένο στο πρότυπο.</string>
    <string name="help_custom_template_list_editing">Υπάρχοντα πρότυπα μπορούν να επεξεργαστούν και να διαγραφούν.</string>
    <string name="help_custom_template_list_using">Το δημιουργημένο πρότυπο μπορεί να χρησιμοποιηθεί από το πλευρικό μενού.</string>
    <string name="help_tutorial_01">Γράψτε μια έκφραση σε αυτήν την περιοχή επεξεργασίας και τα αποτελέσματα θα υπολογιστούν αυτόματα και θα εμφανιστούν δεξιά. Η έκφραση μπορεί να τροποποιηθεί ανά πάσα στιγμή, όπως στο Notepad.</string>
    <string name="help_tutorial_02">Όταν πατάτε το αποτέλεσμα, εμφανίζεται αναδυόμενο με τιμές δυαδικού, δεκαεξαδικού, με φόρο και χωρίς φόρο. Μπορείτε επίσης να αντιγράψετε το αποτέλεσμα στο πρόχειρο με παρατεταμένο πάτημα.</string>
    <string name="help_tutorial_03">Μπορείτε να κάνετε υπολογισμούς σε πολλές γραμμές και να προσθέσετε σχόλια στις εκφράσεις σας.</string>
    <string name="help_tutorial_04">Οι εκφράσεις υπολογίζονται ανά γραμμή, ώστε να συγκρίνετε τα αποτελέσματα γρήγορα.</string>
    <string name="help_tutorial_05">Εμφανίζεται ένα τρέχον σύνολο όλων των γραμμών. Μπορείτε επίσης να δείτε μέσο όρο, τιμές με και χωρίς φόρο.</string>
    <string name="help_tutorial_06">Μπορείτε να εισαγάγετε αναφορά γραμμής πατώντας στον αριθμό γραμμής. Π.χ. αν πατήσετε τη 2η γραμμή, εισάγεται <xliff:g id="variable_name">"$2"</xliff:g>.</string>
    <string name="help_tutorial_07">Οι μεταβλητές αναφοράς μπορούν να χρησιμοποιηθούν στις εκφράσεις σας. Στο παράδειγμα αφαιρεί τα αποτελέσματα από τις γραμμές 2 και 3.</string>
    <string name="help_tutorial_08">Αν αλλάξουν οι εκφράσεις στη 2η ή 3η γραμμή, οι εκφράσεις που χρησιμοποιούν τη μεταβλητή αναφοράς επαναϋπολογίζονται αυτόματα.</string>
    <string name="help_tutorial_09">Μπορείτε να εκτελέσετε υποενέργειες σε κουμπί κάνοντας σάρωση πάνω ή κάτω.</string>
    <string name="help_tutorial_10">Μπορείτε να αλλάξετε πληκτρολόγιο σαρώνοντας αριστερά ή δεξιά. Επίσης, μπορείτε να προσαρμόσετε πλήρως τη διάταξη από την οθόνη ρυθμίσεων <xliff:g id="ref_preference_title_customize_keypad">"Προσαρμογή πληκτρολογίου"</xliff:g>.</string>
    <string name="help_tutorial_11">Μπορείτε να εμφανίσετε το πλευρικό μενού σαρώνοντας από την αριστερή άκρη της οθόνης ή πατώντας το εικονίδιο μενού στη γραμμή ενεργειών.</string>
    <string name="help_tutorial_12">Ανατρέξτε στη διαδικτυακή βοήθεια για λεπτομέρειες χρήσης του <xliff:g id="app_name">CalcNote</xliff:g>.</string>
