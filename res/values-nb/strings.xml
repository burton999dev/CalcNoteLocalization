    <string name="changelog_review_request">
        <xliff:g id="app_name">CalcNote</xliff:g> er et hobbyprosjekt, og motivasjon kan være utfordrende. Din positive vurdering motiverer meg til å forbedre <xliff:g id="app_name">CalcNote</xliff:g>. Del gjerne med venner eller på sosiale medier. Takk for støtten!</string>
    <string name="help_custom_save">Til slutt, trykk Lagre-knappen for å fullføre.</string>
