    <string name="help_custom_keypad_edit_selecting_button">Velg knappen du vil tilpasse.</string>
    <string name="help_custom_keypad_edit_selecting_action">Tildel en handling og en underhandling til knappen.</string>
    <string name="help_custom_keypad_edit_setting_primary_columns">Angi grensen mellom tallknapper og operatorknapper.</string>
    <string name="help_custom_result1">Du kan tilpasse dialogen som vises når du trykker på resultatet.</string>
    <string name="help_custom_result2">Du kan referere til beregningsresultatet med en variabel kalt <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_result3">For eksempel, hvis du setter tittelen til "10% OFF" og uttrykket til <xliff:g id="expression">[result - 10%]</xliff:g>, kan det vises med 10% rabatt.</string>
    <string name="help_custom_result4">Du kan også bruke en funksjon i et matematisk uttrykk. For eksempel, hvis du setter tittelen til <xliff:g id="title">"EUR→USD"</xliff:g> og uttrykket til <xliff:g id="expression">[eur_usd(result)]</xliff:g>, kan du vise den konverterte USD-verdien fra euro.</string>
    <string name="help_custom_result_title">Skriv inn tittelen.</string>
    <string name="help_custom_result_expression">Skriv inn uttrykket. Du kan referere til resultatet med variabelen <xliff:g id="variable_name">"result"</xliff:g>.</string>
    <string name="help_custom_action1">Ved å opprette en brukerdefinert handling kan du tildele vilkårlige uttrykk til en knapp.</string>
    <string name="help_custom_action2">For eksempel, hvis du setter handlingsnavnet til "Tax" og verdien til <xliff:g id="expression">[+ 6%]</xliff:g>, kan prisen vises inkludert mva.</string>
    <string name="help_custom_action_name">Skriv inn handlingsnavnet som vises på knappen.</string>
    <string name="help_custom_action_value">Et vilkårlig uttrykk kan angis som verdi.</string>
    <string name="help_custom_action3">Den opprettede handlingen kan tilordnes en knapp i innstillingsskjermen <xliff:g id="ref_preference_title_customize_keypad">"Tilpass tastaturet"</xliff:g>.</string>
    <string name="help_custom_constant1">Ved å opprette en brukerdefinert konstant kan du definere en vilkårlig konstant som <xliff:g id="pi">"π"</xliff:g> og bruke den i uttrykkene dine.</string>
    <string name="help_custom_constant2">For eksempel, hvis du setter konstantnavnet til <xliff:g id="napier_name">"e"</xliff:g> og verdien til <xliff:g id="napier_value">[2.718281828459045]</xliff:g>, kan du referere til Napiers tall i uttrykkene dine med <xliff:g id="napier_name">"e"</xliff:g>.</string>
    <string name="help_custom_constant_name">Konstantnavn er store/små-følsomt.</string>
    <string name="help_custom_constant_value">Et vilkårlig tall kan angis som verdi.</string>
    <string name="help_custom_constant3">Den opprettede konstanten kan tilordnes en knapp i innstillingsskjermen <xliff:g id="ref_preference_title_customize_keypad">"Tilpass tastaturet"</xliff:g>.</string>
    <string name="help_custom_function1">Ved å opprette en brukerdefinert funksjon kan du definere beregningslogikken i <xliff:g id="programming_language">JavaScript</xliff:g>.</string>
    <string name="help_custom_function2">Den opprettede funksjonen kan tilordnes en knapp i innstillingsskjermen <xliff:g id="ref_preference_title_customize_keypad">"Tilpass tastaturet"</xliff:g>.</string>
