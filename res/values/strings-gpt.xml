    <!-- [CHAR LIMIT=25] Title of the dialog shown when a mandatory app update is required. -->
    <string name="dialog_title_app_update_required">App Update Required</string>
    <!-- [CHAR LIMIT=400] Message content of the dialog shown when a mandatory app update is required. -->
    <string name="dialog_message_app_update_required">A new version of the app is available. To access the latest features and security updates, please update the app. If you are unable to update due to connectivity issues or any other problems, please check your connection and try again. Please note that you won\'t be able to use the app without this update. We appreciate your understanding and cooperation.</string>

