    <!-- [CHAR LIMIT=150] Description displayed in the tutorial that explains how to use application. -->
    <string name="help_custom_list1">By creating a user-defined list, you can organize frequently used items into a list, simplifying data entry.</string>
    <!-- [CHAR LIMIT=150] Description displayed in the tutorial that explains how to use application. -->
    <string name="help_custom_list2">For example, listing fixed monthly expenses can simplify budget management.</string>
    <!-- [CHAR LIMIT=150] Description displayed in the tutorial that explains how to use application. -->
    <string name="help_custom_list3">The created list can be assigned to a button in the <xliff:g id="ref_preference_title_customize_keypad">"Customize Keypad"</xliff:g> settings.</string>
    <!-- [CHAR LIMIT=150] Description displayed in the tutorial that explains how to use application. -->
    <string name="help_custom_list_name">Enter the list name to be displayed on the button.</string>
    <!-- [CHAR LIMIT=150] Description displayed in the tutorial that explains how to use application. -->
    <string name="help_custom_list_items">Add list items. You can set arbitrary expressions and descriptions for each item.</string>

