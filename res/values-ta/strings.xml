    <string name="changelog_review_request">
        <xliff:g id="app_name">CalcNote</xliff:g> ஒரு பொழுதுபோக்கு திட்டமாக உருவாக்கப்பட்டது, மற்றும் உந்துதலைப் பராமரிப்பது சில நேரங்களில் கடினமாக இருக்கும். உங்கள் நேர்மறை மதிப்பீடு <xliff:g id="app_name">CalcNote</xliff:g>-ஐ தொடர்ந்து மேம்படுத்த எனக்கு ஊக்கமளிக்கும். கூடுதலாக, இந்த பயன்பாட்டைப் உங்கள் நண்பர்களிடம் அறிமுகப்படுத்தினால் அல்லது சமூக ஊடகங்களில் பகிர்ந்தால் மிகவும் நன்றி. உங்கள் வலியான ஆதரவுக்கு நன்றி.</string>
    <string name="help_custom_save">இறுதியாக, சேமி பொத்தானைத் தட்டி முடிக்கவும்.</string>
    <string name="help_changing_display_order">காட்சிப் பட்டியலில் உருப்படிகளை இழுத்துவைத்து முறையை மாற்றலாம்.</string>
    <string name="help_hiding_list_items">தேவையில்லாத உருப்படிகளை அவர்களின் செக்பாக்ஸை அணைத்து மறைக்கலாம்.</string>
    <string name="help_custom_keypad_list_creating">உங்கள் பரிமாணத்திற்கு பொருந்தும் தனிப்பயன் விசைப்பலகை உருவாக்கலாம்.</string>
    <string name="help_custom_keypad_list_editing">விசைப்பலகைகள் நகலெடுக்க, திருத்த, மற்றும் அழிக்கலாம்.</string>
    <string name="help_custom_keypad_edit_name">விசைப்பலகை பெயரை உள்ளிடவும்.</string>
    <string name="help_custom_keypad_edit_selecting_button">விருப்பமயற்றவேண்டிய பொத்தானை தேர்ந்தெடுக்கவும்.</string>
    <string name="help_custom_keypad_edit_selecting_action">பொத்தானுக்கு ஒரு செயல் மற்றும் உப-செயல் ஒதுக்கவும்.</string>
    <string name="help_custom_keypad_edit_setting_primary_columns">எண் பொத்தான்கள் மற்றும் ஆபரேட்டர் பொத்தான்களுக்கிடையேயான எல்லையை அமைக்கவும்.</string>
    <string name="help_custom_result1">கணக்கொளி விளைவைத் தட்டும்போது காட்டப்படும் உரையாடலை விருப்பமயற்றலாம்.</string>
    <string name="help_custom_result2"><xliff:g id="variable_name">"result"</xliff:g> என்ற மாறிலியைப் பயன்படுத்தி கணக்கொளி விளைவைக் குறிப்பிடலாம்.</string>
    <string name="help_custom_result3">உதாரணமாக, தலைப்பை "10% OFF" என்று அமைத்து வெளிப்பாட்டை <xliff:g id="expression">[result - 10%]</xliff:g> என்று அமைத்தால், 10% தள்ளுபடி விகிதத்துடன் காட்டலாம்.</string>
    <string name="help_custom_result4">மேலும், கணக்குப் வெளிப்பாட்டில் செயல்பாட்டைப் பயன்படுத்தலாம். உதாரணமாக, "EUR→USD" என்று தலைப்பை அமைத்து [eur_usd(result)] என வெளியீட்டை அமைத்தால் யூரோவை அமெரிக்க டாலராக மாற்றிக்காணலாம்.</string>
    <string name="help_custom_result_title">தலைப்பை உள்ளிடவும்.</string>
    <string name="help_custom_result_expression">கணக்குப் பொதிமுறையை உள்ளிடவும். <xliff:g id="variable_name">"result"</xliff:g> என்ற மாறியைப் பயன்படுத்தி விளைவைக் குறிப்பிடலாம்.</string>
    <string name="help_custom_action1">பயனர் வரையறுத்த செயலை உருவாக்கி, எந்தவொரு கணக்குப் பொதிமுறையையும் பொத்தானில் ஒதுக்கலாம்.</string>
    <string name="help_custom_action2">உதாரணமாக, செயல் பெயரை "Tax" என்று அமைத்து மதிப்பை <xliff:g id="expression">[+ 6%]</xliff:g> என்று அமைத்தால், விலையில் வரி சேர்த்துக் காட்டலாம்.</string>
    <string name="help_custom_action_name">பொத்தானில் காணப்படும் செயல் பெயரை உள்ளிடவும்.</string>
    <string name="help_custom_action_value">மதிப்பிற்கு எந்தவொரு கணக்குப் பொதிமுறையும் அமைக்கலாம்.</string>
    <string name="help_custom_action3">உருவாக்கப்பட்ட செயலை <xliff:g id="ref_preference_title_customize_keypad">"விசைப்பலகையை விருப்பமயற்றவும்"</xliff:g> அமைப்புகள் திரையில் பொத்தானுக்கு ஒதுக்கலாம்.</string>
    <string name="help_custom_constant1">பயனர் வரையறுத்த நிலையளவு உருவாக்கி <xliff:g id="pi">"π"</xliff:g> போன்ற எந்தவொரு நிலை மதிப்பையும் உங்களது சூத்திரங்களில் பயன்படுத்தலாம்.</string>
    <string name="help_custom_constant2">உதாரணமாக, நிலையளவு பெயரை <xliff:g id="napier_name">"e"</xliff:g> என்றும் மதிப்பை <xliff:g id="napier_value">[2.718281828459045]</xliff:g> என்றும் அமைத்தால், <xliff:g id="napier_name">"e"</xliff:g> ஐ சூத்திரங்களில் குறிப்பிடலாம்.</string>
    <string name="help_custom_constant_name">நிலையளவு பெயர் எழுத்துக்கணிச் வேறுபாட்டினை பேணும்.</string>
    <string name="help_custom_constant_value">எந்தவொரு எண்ணையும் மதிப்பாக அமைக்கலாம்.</string>
    <string name="help_custom_constant3">உருவாக்கப்பட்ட நிலையளவை <xliff:g id="ref_preference_title_customize_keypad">"விசைப்பலகையை விருப்பமயற்றவும்"</xliff:g> அமைப்புகள் திரையில் பொத்தானுக்கு ஒதுக்கலாம்.</string>
    <string name="help_custom_function1">பயனர் வரையறுத்த செயல்பாட்டை உருவாக்கி, <xliff:g id="programming_language">JavaScript</xliff:g> இல் உங்களது கணக்கீட்டு தர்க்கத்தை வரையறுக்கலாம்.</string>
    <string name="help_custom_function2">உருவாக்கப்பட்ட செயல்பாட்டை <xliff:g id="ref_preference_title_customize_keypad">"விசைப்பலகையை விருப்பமயற்றவும்"</xliff:g> அமைப்புகள் திரையில் பொத்தானுக்கு ஒதுக்கலாம்.</string>
    <string name="help_custom_function_name">செயல்பாட்டு பெயரை உள்ளிடவும்.</string>
    <string name="help_custom_function_description">செயல்பாட்டின் விளக்கத்தை உள்ளிடவும். இது செயல் உதவிக்கு பயன்படுத்தப்படும். இந்த புலம் விருப்பத்தின் படி.</string>
    <string name="help_custom_function_argument_count">அளவுரு எண்ணிக்கையை தேர்ந்தெடுக்கவும்.</string>
    <string name="help_custom_function_return_value_description">திரும்புமதிப்பு விளக்கத்தை உள்ளிடவும். இது செயல் உதவிக்கு பயன்படும். இந்தப் புலம் விருப்பத்திற்குரியது.</string>
    <string name="help_custom_function_arg_name">அளவுரு பெயரை உள்ளிடவும்.</string>
    <string name="help_custom_function_arg_description">அளவுரின் விளக்கத்தை உள்ளிடவும். இது செயல் உதவிக்கு பயன்படும். இந்தப் புலம் விருப்பத்தேர்வானது.</string>
    <string name="help_custom_code"><xliff:g id="programming_language">JavaScript</xliff:g> இல் குறியீட்டை எழுதவும்.</string>
    <string name="help_custom_function_arg_value">சோதனைக்காக வாத மதிப்பை உள்ளிடவும்.</string>
    <string name="help_custom_function_test">குறிப்பிட்ட வாதத்துடன் செயல்பாட்டை இயக்கவும். விளைவு சரியானதா என்பதை உறுதிப்படுத்தவும்.</string>
    <string name="help_custom_template_list_creating">அடிக்கடி பயன்படுத்தப்படும் கணக்குப் பொதிமுறையை வார்ப்புருவாக சேமித்து, புதிதாக கோப்பு உருவாக்குவதற்குப் பதில் வார்ப்புருவின் அடிப்படையில் எளிதில் கோப்பை உருவாக்கலாம்.</string>
    <string name="help_custom_template_list_editing">ஏற்கனவே உள்ள வார்ப்புருக்களை திருத்தவும் அழிக்கவும் முடியும்.</string>
    <string name="help_custom_template_list_using">உருவாக்கப்பட்ட வார்ப்புருவை பக்க மெனுவிலிருந்து பயன்படுத்தலாம்.</string>
    <string name="help_tutorial_01">இந்த திருத்துப் பகுதியில் கணக்குப் பொதிமுறையை எழுதுங்கள், விளைவுகள் தானாக கணக்கிடப்பட்டு வலது பக்கத்தில் காட்டப்படும். எவ்வித வேளையிலும் கணக்குப் பொதிமுறையைத் திருத்தலாம், நொட்பேடு போன்றது.</string>
    <string name="help_tutorial_02">விளைவைத் தட்டும்போது பைனரி, ஹெக்ஸாடெசிமல், வரி உட்பட, மற்றும் வரி இன்றி மதிப்புகள் பாப்அப்பில் காட்டப்படும். மேலும், விளைவில் நீண்ட தட்டும் செய்கையால் மதிப்பை கிளிப்போர்டிற்கு நகலெடுக்கலாம்.</string>
    <string name="help_tutorial_03">நீங்கள் பல வரிகளில் கணக்கிடலாம், மற்றும் சூத்திரங்களுக்கு பதிவுகளையும் எழுதலாம்.</string>
    <string name="help_tutorial_04">ஒவ்வொரு வரிக்கும் கணக்குப் பொதிமுறைகள் கணக்கிடப்படுவதால், விளைவுகளை வேகமாக ஒப்பிடலாம்.</string>
    <string name="help_tutorial_05">அனைத்து வரிகளின் மொத்தம் காண்பிக்கப்படும். மேலும் சராசரி, வரி உட்பட, மற்றும் வரி இன்றி மதிப்புகளையும் காணலாம்.</string>
    <string name="help_tutorial_06">வரிசை எண் மேல் தட்டுவதன் மூலம் வரிசை குறிப்பை உள்ளிடலாம். உதாரணமாக, இரண்டாவது வரியைத் தட்டினால் <xliff:g id="variable_name">"$2"</xliff:g> சேர்க்கப்படும்.</string>
    <string name="help_tutorial_07">குறிப்பிட மாறிகளை உங்கள் கணக்குப் பொதிமுறைகளில் பயன்படுத்தலாம். இந்த உதாரணத்தில் வரி 2 மற்றும் 3 இல் உள்ள விளைவுகளை கழிக்கிறது.</string>
    <string name="help_tutorial_08">இரண்டாவது அல்லது மூன்றாவது வரிகளின் கணக்குப் பொதிமுறைகள் மாற்றப்படின், குறிப்பிட மாறியைப் பயன்படுத்தும் கணக்குப் பொதிமுறைகள் தானாக மீண்டும் கணக்கிடப்படும்.</string>
    <string name="help_tutorial_09">ஒரு பொத்தானுக்கு ஒதுக்கப்பட்ட உப-செயல்களை மேலே அல்லது கீழே ஸ்வைப் செய்து இயக்கலாம்.</string>
    <string name="help_tutorial_10">விசைப்பலகையை இடது அல்லது வலது பக்கம் ஸ்வைப் செய்து மாற்றலாம். மேலும், <xliff:g id="ref_preference_title_customize_keypad">"விசைப்பலகையை விருப்பமயற்றவும்"</xliff:g> அமைப்புகள் திரையில் விசைப்பலகை ஒப்பை முழுவதும் விருப்பமயற்றலாம்.</string>
    <string name="help_tutorial_11">திரையின் இடப்பக்கம் ஸ்வைப் செய்வதன் மூலம் அல்லது செயல் பட்டியில் உள்ள மெனு படிமத்தைத் தட்டுவதன் மூலம் பக்க மெனுவை காண்பிக்கலாம்.</string>
    <string name="help_tutorial_12"><xliff:g id="app_name">CalcNote</xliff:g> யின் விவரமான பயன்பாட்டுக்கு ஆன்லைன் உதவியைப் பார்க்கவும்.</string>
